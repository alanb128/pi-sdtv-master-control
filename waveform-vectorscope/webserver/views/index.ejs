<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Integrated Broadcast Monitor</title>
    <style>
        html, body {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background-color: #050505; overflow: hidden;
            font-family: monospace; user-select: none;
        }
        .hide-cursor { cursor: none; }
        canvas { display: block; width: 100%; height: 100%; }
        p {
            z-index: 10; background: #111; color: #ADDFFF; border: 1px solid #00ff40; 
            padding: 12px 34px; font-size: 1.8rem; cursor: pointer; letter-spacing: 1px;
        }
        a {
           color: #56A5EC;
          }
        .container {
           display: flex;
           justify-content: space-between;
          }
    </style>
</head>
<body>
<br>
<div class="container"><span style="color: white; font-size: 2rem;">Broadcast Monitor</span><span style="align: right; color: white; font-size: 1.2rem"><%= deviceName%> - <%= my_com%></span></div>
<br>
<p><a href="http://webserver/waveform" id="link_wf" autofocus>Waveform monitor</a></p>
<p><a href="http://webserver/vectorscope" id="link_vs">Vectorscope</a></p>
<p><a href="http://webserver/vumeter" id="link_vu">VU meter</a></p>
<p><a href="http://webserver/full_video" id="link_fs">Fullscreen video</a></p>
<p><a href="http://webserver/video_vu" id="link_fv">Video with VU</a></p>
</body>
</html>
